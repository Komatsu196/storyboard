{
	"name": "web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"deploy": "pnpm build && wrangler deploy",
		"test": "vitest run",
		"check": "wrangler types && biome check && tsc -b tsconfig.json",
		"types": "wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply storyboard --local",
		"db:migrate:remote": "wrangler d1 migrations apply storyboard --remote"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.0",
		"@tanstack/react-query": "^5.100.0",
		"@tanstack/react-router": "^1.170.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.0",
		"lucide-react": "^1.48.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"zod": "^4.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@cloudflare/vite-plugin": "^1.54.0",
		"@cloudflare/vitest-plugin": "^1.1.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/router-plugin": "^1.168.0",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.9",
		"tailwindcss": "^4.1.18",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^4.1.0",
		"wrangler": "^4.131.0"
	}
}
